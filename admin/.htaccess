Options -Indexes
DirectoryIndex index.php

# Never serve config, library or data files directly
<FilesMatch "^(config\.php|config\.sample\.php|lib\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Cache-Control "no-store"
</IfModule>
